# Copie para .env e preencha. Sem as chaves de uma plataforma, ela roda em modo exemplo.

# Acesso ao app
APP_PASSWORD=troque-esta-senha
APP_USER_NAME=Edson Jr
SESSION_SECRET=gere-um-texto-aleatorio-longo
PORT=3000

# Gestor de tráfego IA (Claude API)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Meta Marketing API: token de Usuário do Sistema do Business Manager
META_ACCESS_TOKEN=
META_API_VERSION=v23.0

# Google Ads API (o developer token fica vazio se o Google não exigir mais)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_API_VERSION=v21
